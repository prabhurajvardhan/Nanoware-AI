# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required by server-side Firebase Admin Auth/Firestore in production.
# Store the complete service-account JSON as one secret value; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"nanoware-ai","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'

# Razorpay Subscriptions API configuration. These values are server-only.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
# Create matching monthly Plans in Razorpay Dashboard/API and set their IDs here.
# The plan amount/currency must match the configured Daken/Daken+ catalogue.
RAZORPAY_DAKEN_PLAN_ID="plan_..."
RAZORPAY_DAKEN_PLUS_PLAN_ID="plan_..."
# Razorpay requires a finite cycle count. Default allows up to 100 years of monthly cycles.
RAZORPAY_SUBSCRIPTION_TOTAL_CYCLES="1200"
# Keep false until end-to-end billing and entitlement checks are complete.
DAKEN_CHECKOUT_ENABLED="false"
DAKEN_PLUS_CHECKOUT_ENABLED="false"

# Email is sent through Zoho SMTP. Configure these server-side only in Vercel.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ADMIN_EMAIL: Email address to receive admin notifications.
ADMIN_EMAIL="admin@nanoware.ai"
