rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function hasBusinessMembership(businessId) {
      return isSignedIn() && exists(/databases/$(database)/documents/memberships/$(businessId + '__' + request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(businessId + '__' + request.auth.uid)).data.status == 'active';
    }
    function hasBusinessRole(businessId, allowedRoles) {
      return hasBusinessMembership(businessId) &&
        get(/databases/$(database)/documents/memberships/$(businessId + '__' + request.auth.uid)).data.role in allowedRoles;
    }
    function canReadProject(projectId) {
      return isAdmin() ||
        (get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['businessId']) && hasBusinessMembership(get(/databases/$(database)/documents/projects/$(projectId)).data.businessId)) ||
        (!get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['businessId']) && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'businessId', 'name', 'status', 'createdAt']) &&
        data.keys().size() == 5 && data.userId is string && data.userId.size() <= 128 &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.status is string && data.status in ['active', 'completed'] && data.createdAt == request.time;
    }

    match /requests/{requestId} {
      allow create: if false;
      allow read, update, delete: if false;
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Tenant identity and memberships are provisioned only by verified server routes.
    match /businesses/{businessId} {
      allow read, write: if false;
    }
    match /memberships/{membershipId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow create: if isSignedIn() && isValidProject(incoming()) && hasBusinessRole(incoming().businessId, ['owner', 'admin']);
      allow get: if isValidId(projectId) && canReadProject(projectId);
      allow list: if isAdmin() ||
        (resource.data.keys().hasAny(['businessId']) && hasBusinessMembership(resource.data.businessId)) ||
        (!resource.data.keys().hasAny(['businessId']) && isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (existing().keys().hasAny(['businessId']) && hasBusinessRole(existing().businessId, ['owner', 'admin']));

      match /steps/{stepId} {
        allow create, update, delete: if isAdmin() ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['businessId']) && hasBusinessRole(get(/databases/$(database)/documents/projects/$(projectId)).data.businessId, ['owner', 'admin']));
        allow read: if isValidId(stepId) && isValidId(projectId) && canReadProject(projectId);
      }

      match /activities/{activityId} {
        // Feedback is written through the authenticated server route, not from the browser.
        allow create, update, delete: if isAdmin() ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['businessId']) && hasBusinessRole(get(/databases/$(database)/documents/projects/$(projectId)).data.businessId, ['owner', 'admin']));
        allow read: if isValidId(activityId) && isValidId(projectId) && canReadProject(projectId);
      }
    }
  }
}
